# Public project coordinates. The anon key is designed for browser use and is constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters. Used only to HMAC trusted proxy IPs.
ABUSE_RATE_LIMIT_SECRET=
